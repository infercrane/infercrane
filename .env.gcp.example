# Copy outside the repository, replace every placeholder, and keep the file private.
GCLOUD_CONFIG_DIR=/absolute/path/to/read-only-gcloud-config
INFERCRANE_GCP_PROJECT=replace-with-isolated-project
INFERCRANE_GCP_ZONE=europe-west4-a
INFERCRANE_GCP_SUBNET=replace-with-private-subnet
INFERCRANE_GCP_MACHINE_TYPE=g2-standard-4
INFERCRANE_GCP_GPU=nvidia-l4
INFERCRANE_GCP_SERVICE_ACCOUNT=runtime@replace-with-isolated-project.iam.gserviceaccount.com
INFERCRANE_GCP_VM_IMAGE=projects/cos-cloud/global/images/replace-with-immutable-image
INFERCRANE_GCP_CONTAINER_IMAGE=registry.example/runtime@sha256:replace-with-qualified-digest
INFERCRANE_GCP_WORKER_SECRET=replace-with-worker-secret-name
INFERCRANE_GCP_BOOT_DISK_GIB=200
