{
  "name": "@infercrane/ai-sdk-provider",
  "version": "0.1.0",
  "description": "InferCrane provider for the Vercel AI SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://docs.infercrane.com/integrations/ai-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/infercrane/infercrane.git",
    "directory": "sdk/ai-sdk-provider"
  },
  "bugs": {
    "url": "https://github.com/infercrane/infercrane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@ai-sdk/provider-utils": "^5.0.47"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ai": "^7.0.113",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.1.11"
  }
}
