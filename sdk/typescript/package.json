{
  "name": "@infercrane/sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript client for the InferCrane inference control plane",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://docs.infercrane.com/integrations/typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/infercrane/infercrane.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/infercrane/infercrane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  }
}
