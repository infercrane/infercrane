# Copy to a private file outside version control and replace every example value.
INFERCRANE_IMAGE=ghcr.io/infercrane/infercrane:v1.0.0
INFERCRANE_URL=https://infercrane.example
INFERCRANE_API_KEY=replace-with-at-least-32-random-characters
INFERCRANE_POSTGRES_PASSWORD=replace-with-a-random-database-password
# Optional.
INFERCRANE_INSTANCE_ID=compose-1
INFERCRANE_PORT=8080
# Optional hosted-console authentication. Configure all values together.
# Store the PEM key in your deployment secret manager. Use the file variant
# instead when your platform mounts secrets as files; never configure both.
# INFERCRANE_HOSTED_AUTH_ISSUER=https://your-instance.clerk.accounts.dev
# INFERCRANE_HOSTED_AUTH_AUDIENCE=infercrane-control
# INFERCRANE_HOSTED_AUTH_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace\n-----END PUBLIC KEY-----"
# INFERCRANE_HOSTED_AUTH_JWT_KEY_FILE=/run/secrets/clerk-jwt.pem
# INFERCRANE_HOSTED_AUTH_AUTHORIZED_PARTIES=https://console.infercrane.com
# Optional prepaid managed-model funding. Configure all values together.
# Keep keys in your deployment secret manager, never in this file or Git.
# INFERCRANE_STRIPE_SECRET_KEY=sk_live_replace
# INFERCRANE_STRIPE_WEBHOOK_SECRET=whsec_replace
# INFERCRANE_STRIPE_LIVEMODE=true
# INFERCRANE_BILLING_RETURN_URL=https://console.infercrane.com/usage
# INFERCRANE_STRIPE_PRICE_IDS_JSON={"25":"price_replace","50":"price_replace","100":"price_replace","250":"price_replace","500":"price_replace"}
# Optional internal Model API catalog. The file contains procurement routing and
# must be readable only by the control plane; its internal fields are never
# returned by the customer catalog API.
# INFERCRANE_MODEL_API_CATALOG_FILE=/run/secrets/model-api-catalog.json
