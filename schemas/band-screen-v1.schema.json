{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infercrane.dev/schemas/band-screen-v1.schema.json",
  "title": "InferCrane band screen v1",
  "description": "A content-free summary of a screen: setups measured in turn on one machine at one or more loads, the current setup first and last, optionally a copy of it. `infercrane optimize band-verdict` reads it and gives a verdict per load band. A setup's ID appears once per band and is not the current setup's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "limit_ms", "current", "rules", "bands"],
  "properties": {
    "schema_version": {"const": "infercrane.dev/band-screen/v1"},
    "metric": {"enum": ["useful_output", "output"]},
    "limit_ms": {"type": "number", "minimum": 0},
    "current": {"type": "string", "minLength": 1},
    "copy": {"type": "string"},
    "rules": {
      "type": "object", "additionalProperties": false, "required": ["max_current_spread", "min_noise_floor"],
      "properties": {
        "max_current_spread": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "min_noise_floor": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
      }
    },
    "bands": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "load", "current_runs", "setups"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "load": {"type": "integer", "minimum": 1},
        "current_runs": {"type": "array", "items": {"$ref": "#/$defs/measure"}},
        "setups": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "runs"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "runs": {"type": "array", "items": {"$ref": "#/$defs/measure"}},
            "held_back": {"type": "string"}
          }
        }}
      }
    }}
  },
  "$defs": {
    "measure": {
      "type": "object", "additionalProperties": false, "required": ["output"],
      "properties": {"output": {"type": "number", "minimum": 0}, "useful_output": {"type": "number", "minimum": 0}}
    }
  }
}
