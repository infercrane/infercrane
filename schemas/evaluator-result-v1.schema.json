{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infercrane.dev/schemas/evaluator-result-v1.schema.json",
  "title": "InferCrane evaluator result v1",
  "description": "Content-free aggregate task-quality result produced by a customer-owned evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite",
    "suite_version",
    "evaluator",
    "evaluator_version",
    "score",
    "passed",
    "sample_count",
    "artifact_digest",
    "evaluated_at"
  ],
  "properties": {
    "schema": {
      "const": "infercrane.dev/evaluator-result/v1"
    },
    "suite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "suite_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "evaluator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "passed": {
      "type": "boolean"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
