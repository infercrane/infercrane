# Add these values to the private environment file used with
# compose.production.aws.yaml. Never commit populated credentials.
AWS_CONFIG_DIR=/absolute/path/to/read-only/aws-config-directory
AWS_PROFILE=default
INFERCRANE_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/infercrane-control-plane
INFERCRANE_AWS_EXTERNAL_ID=replace-with-organization-controlled-value
INFERCRANE_AWS_REGION=eu-central-1
INFERCRANE_AWS_SUBNET_ID=subnet-replace
INFERCRANE_AWS_SECURITY_GROUP_IDS=sg-replace
INFERCRANE_AWS_AMI_ID=ami-replace
INFERCRANE_AWS_INSTANCE_TYPE=g6e.xlarge
INFERCRANE_AWS_GPU=L40S
INFERCRANE_AWS_INSTANCE_PROFILE_ARN=arn:aws:iam::123456789012:instance-profile/infercrane-worker
INFERCRANE_AWS_WORKER_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:123456789012:secret:infercrane-worker-key
INFERCRANE_AWS_IMAGE_DIGEST=vllm/vllm-openai@sha256:replace-with-qualified-digest
INFERCRANE_AWS_IMAGE_CACHE_POLICY=prefer
INFERCRANE_AWS_ROOT_VOLUME_GIB=200
# Optional exact model@commit -> verified encrypted EBS snapshot mapping.
# The snapshot filesystem must be labeled INFERCRANE_ART and contain the
# Hugging Face cache tree at its root.
INFERCRANE_AWS_ARTIFACT_CACHE_POLICY=prefer
INFERCRANE_AWS_ARTIFACT_SNAPSHOTS_JSON={}
# 0 leaves EBS initialization behavior at the provider default. Values 100-300
# explicitly request AWS provisioned initialization and may incur charges.
INFERCRANE_AWS_ARTIFACT_VOLUME_INITIALIZATION_RATE_MIBPS=0

# Explicit snapshot-builder inputs. These are consumed only by
# scripts/aws-artifact-cache-build.sh, not by the InferCrane service.
INFERCRANE_AWS_ARTIFACT_BUILD_RUN_ID=replace-with-unique-run-id
INFERCRANE_AWS_ARTIFACT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
INFERCRANE_AWS_ARTIFACT_REVISION=c170c708c41dac9275d15a8fff4eca08d52bab71
INFERCRANE_AWS_ARTIFACT_BUILDER_AMI_ID=ami-replace
INFERCRANE_AWS_ARTIFACT_BUILDER_SUBNET_ID=subnet-replace
INFERCRANE_AWS_ARTIFACT_BUILDER_SECURITY_GROUP_IDS=sg-replace
INFERCRANE_AWS_ARTIFACT_BUILDER_INSTANCE_TYPE=t3.small
INFERCRANE_AWS_ARTIFACT_VOLUME_GIB=40
