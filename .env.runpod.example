# Add these values to the private environment file used with
# compose.production.runpod.yaml. Never commit the populated file.
RUNPOD_KEY_FILE=/absolute/path/to/runpod-api-key

# Native custom OCI Pods default to 100 GiB. Increase this for large images and
# checkpoints; provider disk charges may apply. Accepted range: 50..2048.
INFERCRANE_RUNPOD_CONTAINER_DISK_GIB=100

# Required only for provider-native Serverless deployments.
INFERCRANE_RUNPOD_SERVERLESS_TEMPLATE_ID=
