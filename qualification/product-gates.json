{
  "schema_version": 1,
  "product": "InferCrane",
  "gates": [
    {
      "id": "developer-environment",
      "tier": "local",
      "description": "Repository, PostgreSQL, race, Kind, SDK, Terraform, recovery, HA, security, dashboard and documentation gates",
      "covers": ["lifecycle", "operations", "routing", "autoscaling", "release-guard", "protocols", "admission", "async", "inspector-doctor", "alerts", "replay", "recipes-lab", "capacity-intelligence", "finops", "passport", "sessions", "sdks", "terraform", "dashboard", "terminal-ui", "persistence-ha", "security", "kubernetes-api"]
    },
    {
      "id": "product-journeys",
      "tier": "local",
      "description": "Black-box installation, first value, adoption, recovery and release journeys through public surfaces",
      "covers": ["cli", "stable-endpoints", "adoption", "openai-gateway", "durable-resume", "explanations", "release-package"]
    },
    {
      "id": "adapter-contracts",
      "tier": "local",
      "description": "Provider and runtime idempotency, adoption, inventory and capability conformance",
      "covers": ["runpod-contract", "aws-contract", "gcp-contract", "kubernetes-contract", "external-provider-contract", "vllm-contract", "sglang-contract", "custom-oci-contract"]
    },
    {
      "id": "supply-chain",
      "tier": "local",
      "description": "Dead-code, vulnerability and release artifact verification",
      "covers": ["dead-code", "dependency-audit", "archives", "checksums", "sbom", "homebrew"]
    },
    {
      "id": "continuous-fuzz",
      "tier": "scheduled",
      "description": "Coverage-guided fuzzing of critical state machines with preserved regression corpus",
      "covers": ["route-state-machine", "generation-safety", "malformed-event-sequences"]
    },
    {
      "id": "reliability-soak",
      "tier": "scheduled",
      "description": "Repeated shuffled race and PostgreSQL contention tests for lifecycle-critical packages",
      "covers": ["operation-fencing", "async-leases", "admission", "quota", "autoscaling", "routing", "reconciliation", "provider-retries"]
    },
    {
      "id": "kubernetes-scale",
      "tier": "scheduled",
      "description": "KWOK large-fleet API, scheduler disruption, unroutable pending capacity, inventory and cleanup proof",
      "covers": ["large-kubernetes-fleet", "pending-gpu-capacity", "node-loss", "inventory-scale", "bulk-cleanup"]
    },
    {
      "id": "kubernetes-version-matrix",
      "tier": "scheduled",
      "description": "Kind lifecycle qualification against the maintained Kubernetes minor-version window",
      "covers": ["kubernetes-1.34", "kubernetes-1.35", "kubernetes-1.36"]
    },
    {
      "id": "runpod-serverless-real",
      "tier": "real-infrastructure",
      "description": "RunPod Serverless cold/warm/zero lifecycle, protocols and zero-resource cleanup",
      "covers": ["runpod-serverless", "real-vllm", "streaming", "tool-calls", "structured-output", "cold-warm-zero"]
    },
    {
      "id": "runpod-serverless-faults-real",
      "tier": "real-infrastructure",
      "description": "RunPod Serverless lost-create-response adoption, cancellation and cleanup",
      "covers": ["runpod-serverless", "stream-cancellation", "lost-response-adoption"]
    },
    {
      "id": "runpod-elastic-real",
      "tier": "real-infrastructure",
      "description": "RunPod elastic vLLM lifecycle, protocols, benchmark, autoscaling, Release Guard and cleanup",
      "covers": ["runpod-elastic", "real-vllm", "streaming", "tool-calls", "structured-output", "aiperf", "autoscaling", "release-guard"]
    },
    {
      "id": "runpod-elastic-faults-real",
      "tier": "real-infrastructure",
      "description": "RunPod elastic disconnect, restart, exactly-once creation, generation drain and delete-boundary recovery",
      "covers": ["cli-disconnect", "control-plane-restart", "exactly-one-resource", "generation-drain", "delete-boundary-restart"]
    },
    {
      "id": "aws-real",
      "tier": "real-infrastructure",
      "description": "AWS BYOC lifecycle with real IAM, networking, capacity and GPU runtime",
      "covers": ["aws-ec2", "aws-iam", "aws-private-network", "aws-gpu-runtime"]
    },
    {
      "id": "gcp-real",
      "tier": "real-infrastructure",
      "description": "GCP BYOC lifecycle with real identity, networking, capacity and GPU runtime",
      "covers": ["gcp-compute", "gcp-identity", "gcp-private-network", "gcp-gpu-runtime"]
    },
    {
      "id": "kubernetes-gpu-real",
      "tier": "real-infrastructure",
      "description": "GPU Kubernetes/KServe scheduling, runtime readiness, disruption and cleanup",
      "covers": ["kubernetes-gpu", "kserve-gpu", "node-disruption", "real-cluster-networking"]
    },
    {
      "id": "human-experience",
      "tier": "human",
      "description": "Terminal, browser, docs, installation and operator comprehension review",
      "covers": ["terminal-visual", "dashboard-responsive", "docs-hosted", "clean-machine-install", "operator-remediation"]
    }
  ]
}
