# Add these values to the private environment file used with
# compose.production.kubernetes.yaml.
KUBECONFIG_FILE=/absolute/path/to/restricted/kubeconfig
INFERCRANE_KUBERNETES_CONTEXT=production-cluster
INFERCRANE_KUBERNETES_NAMESPACE=infercrane-system
INFERCRANE_KUBERNETES_WORKLOAD_API=deployment
INFERCRANE_KUBERNETES_SERVICE_ACCOUNT=infercrane-runtime
INFERCRANE_KUBERNETES_WORKER_SECRET_NAME=infercrane-worker
INFERCRANE_KUBERNETES_WORKER_SECRET_KEY=api-key
INFERCRANE_KUBERNETES_IMAGE_DIGEST=vllm/vllm-openai@sha256:replace-with-qualified-digest
INFERCRANE_KUBERNETES_GPU_RESOURCE=nvidia.com/gpu
INFERCRANE_KUBERNETES_GPU_PRODUCT_LABEL=nvidia.com/gpu.product
INFERCRANE_KUBERNETES_IMAGE_CACHE_POLICY=prefer

# Optional NVIDIA Dynamo serving backend. Install Dynamo separately and apply
# deploy/kubernetes/dynamo/provider-rbac.yaml before enabling these values.
INFERCRANE_DYNAMO_VLLM_IMAGE_DIGEST=
INFERCRANE_DYNAMO_VLLM_RUNTIME_VERSION=
INFERCRANE_DYNAMO_SGLANG_IMAGE_DIGEST=
INFERCRANE_DYNAMO_SGLANG_RUNTIME_VERSION=
INFERCRANE_DYNAMO_MODEL_SECRET_NAME=
