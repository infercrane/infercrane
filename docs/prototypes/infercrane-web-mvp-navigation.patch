+function matchesCategory(model: ModelAPIModel, category: (typeof filters)[number][0]) {
+  if (category === "all") return true;
+  if (category === "general") {
+    return model.tasks.some((task) => task === "chat" || task === "reasoning");
+  }
+  if (category === "agents") {
+    return model.tasks.some(
+      (task) => task === "tools" || task === "tool-use" || task === "agentic",
+    );
+  }
+  if (category === "long-context") {
+    return model.tasks.includes("long-context") || (model.context_window_tokens ?? 0) >= 131_072;
+  }
+  return model.tasks.includes(category);
+}
