{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "InferCrane",
  "description": "Deploy and operate AI models across your infrastructure. Build or connect inference with durable operations, safe releases, and inspectable evidence.",
  "logo": {
    "light": "/assets/infercrane-logo-light.svg",
    "dark": "/assets/infercrane-logo-dark.svg",
    "href": "https://infercrane.com"
  },
  "favicon": "/assets/infercrane-favicon.svg",
  "colors": {
    "primary": "#1E40AF",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Albert Sans",
      "weight": 600
    },
    "body": {
      "family": "Albert Sans",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "go"]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Architecture", "href": "/architecture/system" },
          { "label": "Release Guard", "href": "/features/release-guard" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "Website", "href": "https://infercrane.com" },
          { "label": "Join waitlist", "href": "https://infercrane.com/#private-preview" },
          { "label": "Security", "href": "/security" }
        ]
      },
      {
        "header": "For AI agents",
        "items": [
          { "label": "llms.txt", "href": "/llms.txt" },
          { "label": "llms-full.txt", "href": "/llms-full.txt" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor"],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.infercrane.com",
      "og:type": "website",
      "og:site_name": "InferCrane Docs"
    },
    "organization": {
      "name": "InferCrane",
      "url": "https://infercrane.com",
      "sameAs": ["https://infercrane.com"]
    }
  },
