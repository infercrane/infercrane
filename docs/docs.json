{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "InferCrane",
  "description": "Deploy and operate AI models across your infrastructure. Build or connect inference with durable operations, safe releases, and inspectable evidence.",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Space Grotesk",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "vesper"
      }
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "go"]
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/infercrane/infercrane"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/infercrane/infercrane"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Architecture", "href": "/architecture/system" },
          { "label": "Release Guard", "href": "/features/release-guard" }
        ]
      },
      {
        "header": "Project",
        "items": [
          { "label": "GitHub", "href": "https://github.com/infercrane/infercrane" },
          { "label": "Contributing", "href": "https://github.com/infercrane/infercrane/blob/main/CONTRIBUTING.md" },
          { "label": "Security", "href": "/security" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor"],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:type": "website",
      "og:site_name": "InferCrane Docs"
    },
    "organization": {
      "name": "InferCrane",
      "url": "https://github.com/infercrane/infercrane",
      "sameAs": ["https://github.com/infercrane/infercrane"]
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "GET STARTED",
        "pages": ["index", "why-infercrane", "compare", "quickstart", "concepts", "architecture/system"]
      },
      {
        "group": "BUILD",
        "pages": [
          "showcase/index",
          "showcase/build-inference",
          "showcase/connect-existing",
          "features/endpoints",
          "deployment-spec",
          "features/protocols",
          "features/model-artifacts",
          "features/custom-oci",
          "features/provisioning",
          "features/revisions"
        ]
      },
      {
        "group": "OPERATE",
        "pages": [
          "features/lifecycle",
          "features/terminal-ui",
          "features/dashboard",
          "features/autoscaling",
          "features/admission-async",
          "features/release-guard",
          "features/external-capacity",
          "features/serverless",
          "features/telemetry",
          "features/benchmarking",
          "features/cold-starts",
          "features/explanations",
          "showcase/safe-rollouts",
          "showcase/capacity-evidence"
        ]
      },
      {
        "group": "INTELLIGENCE",
        "pages": [
          "features/recipes-lab",
          "features/replay-capacity",
          "features/inference-decisions",
          "features/finops-autopilot",
          "features/inference-passports",
          "features/context-passport-burst"
        ]
      },
      {
        "group": "INTEGRATE",
        "pages": [
          "integrations/overview",
          "integrations/python",
          "integrations/typescript",
          "integrations/terraform",
          "integrations/github-actions",
          "showcase/gateways-and-sandboxes",
          "integrations/vllm",
          "integrations/sglang",
          "integrations/runpod",
          "integrations/aws-ec2",
          "integrations/gcp-compute",
          "integrations/provider-profiles",
          "integrations/kubernetes",
          "integrations/aiperf",
          "integrations/hugging-face",
          "architecture/provider-contract",
          "architecture/runtime-contract"
        ]
      },
      {
        "group": "REFERENCE",
        "pages": [
          "cli",
          "control-api",
          {
            "group": "Control API endpoints",
            "openapi": "openapi.json"
          },
          "provider-setup",
          "runbooks/backup-restore",
          "upgrade",
          "development",
          "troubleshooting",
          "faq"
        ]
      },
      {
        "group": "PROJECT",
        "pages": [
          "project-status",
          "roadmap",
          "security",
          "compatibility"
        ]
      }
    ]
  }
}
