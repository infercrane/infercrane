              "adr/0010-cobra-cli-and-progressive-terminal-output",
              "adr/0011-tiered-provider-qualification",
              "adr/0012-versioned-integration-contracts",
              "adr/0013-governed-external-capacity-and-byoc",
              "adr/0014-generated-automation-clients",
              "adr/0015-embedded-evidence-dashboard",
              "adr/0016-portable-oci-runtime-workloads",
              "adr/0017-deterministic-inference-decisions",
              "adr/0018-signed-release-evidence",
              "adr/0019-kubernetes-integration-boundaries",
              "adr/0020-provider-neutral-production-artifact",
              "adr/0021-stable-endpoint-serving-plans",
              "adr/0022-incremental-adoption-and-deterministic-diagnostics"
            ]
          },
          "release-acceptance"
        ]
      }
    ]
  }
}
