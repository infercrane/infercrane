{
  "name": "infercrane-docs",
  "private": true,
  "version": "1.0.0",
  "description": "InferCrane documentation powered by Mintlify",
  "scripts": {
    "dev": "mint dev",
    "build": "mint validate",
    "validate": "mint validate",
    "check:links": "mint broken-links --check-anchors --check-redirects --check-snippets",
    "check:a11y": "mint a11y",
    "check": "npm run validate && npm run check:links"
  },
  "devDependencies": {
    "mint": "4.2.850"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.1",
    "puppeteer": "25.9.0",
    "puppeteer-core": "25.9.0",
    "qs": "6.16.0",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=20"
  }
}
