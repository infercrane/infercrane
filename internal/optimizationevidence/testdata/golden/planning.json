      ],
      "why": "The KV cache was 97% full while six requests waited, so admission is limited by KV memory. The L40S is an Ada GPU with FP8 support, so an FP8 KV cache on the reviewed interactive profile is the change to measure. The engine did not report how many requests ran at once, so no running-request cap can be set and the plan records that. The reviewed balanced and throughput profiles are generic alternatives no rule chose, so they are left out."
    },
    {
      "id": "h100-engine-queue-larger-batches",
      "request": {
        "model_identity": "acme/novel-open-model",
        "provider": "runpod-pods",
        "gpu": "H100",
        "objective": "interactive",
        "max_candidates": 4,
        "diagnosis": {
          "source": "endpoint_readiness",
          "endpoint": "chat-production",
          "algorithm_version": "monitoring-stage-triage-v2",
          "window_start": "2026-11-17T00:00:00Z",
          "window_end": "2026-11-17T01:00:00Z",
          "state": "profile-ready",
          "primary_bottleneck": "queueing-and-admission",
          "confidence": "stage-and-engine-level",
          "findings": [
            {
              "rule": "queue.engine_wait",
              "signal": "runtime_queue_time_p95",
              "observed": 640,
              "comparison": ">=",
              "threshold": 360,
              "unit": "ms"
            }
          ],
          "signals": {
            "runtime_queue_time_p95": 640,
            "runtime_requests_waiting": 14,
            "runtime_kv_cache_timeseries": 41,
            "p95_latency": 1800
          }
        },
        "model_revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "runtimes": [
          "vllm"
        ]
      },
      "expected_state": "applied",
      "expected_order": [
        "control",
        "batch-budget"
      ],
      "must_not_propose": [
        "fp8-kv-cache",
        "fp8-weights",
        "speculative-mtp"
      ],
      "categories": [
        "queueing"
      ],
      "why": "Requests waited 640 ms at p95 inside the engine while the KV cache was only 41% used, so memory is not what holds them back; the scheduler admits too few per step. On an 80 GB H100, vLLM 0.22.1 already defaults to 1,024 sequences and 8,192 batched tokens, so the larger-batch setup raises both above those defaults (2,048 and 16,384) instead of restating them. Nothing points at precision or speculation."
    },
