  "tasks": [
    {
      "id": "h100-kv-preemption-fp8-kv-first",
      "request": {
        "model_identity": "acme/novel-open-model",
        "provider": "runpod-pods",
        "gpu": "H100",
        "objective": "interactive",
        "max_candidates": 4,
        "diagnosis": {
          "source": "endpoint_readiness",
          "endpoint": "chat-production",
          "algorithm_version": "monitoring-stage-triage-v2",
          "window_start": "2026-11-17T00:00:00Z",
          "window_end": "2026-11-17T01:00:00Z",
          "state": "profile-ready",
          "primary_bottleneck": "kv-cache-pressure",
          "confidence": "stage-and-engine-level",
          "findings": [
            {
              "rule": "kv_cache.preemption",
              "signal": "runtime_preemptions_per_completed_request",
              "observed": 0.08,
              "comparison": ">=",
              "threshold": 0.01,
              "unit": "ratio"
            }
          ],
          "signals": {
            "runtime_requests_running_per_replica": 48,
            "runtime_preemptions_per_completed_request": 0.08,
            "p95_latency": 4200,
            "runtime_kv_cache_timeseries": 99
          }
        },
        "model_revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "runtimes": [
          "vllm"
        ]
      },
      "expected_state": "applied",
      "expected_order": [
        "control",
        "fp8-kv-cache",
        "kv-sequence-cap"
      ],
      "must_not_propose": [
        "batch-budget"
      ],
      "categories": [
        "kv_pressure"
      ],
      "why": "The engine evicted 8 running requests per 100 completed because the KV cache was full, so the KV cache is what binds. An FP8 KV cache stores about twice the tokens in the same memory on an H100, so it comes first. Capping concurrent requests below the 48 observed (to 32) stops the evictions at the cost of some queueing. Adding batch slots would make the evictions worse."
    },
    {
