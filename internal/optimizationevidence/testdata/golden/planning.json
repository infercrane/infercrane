          "window_end": "2026-11-17T01:00:00Z",
          "state": "profile-ready",
          "primary_bottleneck": "host-and-scheduler",
          "confidence": "stage-engine-and-gpu-level",
          "findings": [
            {
              "rule": "gpu.host_bound",
              "signal": "gpu_sm_active",
              "observed": 31,
              "comparison": "<",
              "threshold": 50,
              "unit": "percent"
            }
          ],
          "signals": {
            "gpu_sm_active": 31,
            "runtime_requests_waiting": 9,
            "p95_queue": 420,
            "p95_latency": 1500
          }
        },
        "model_revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "runtimes": [
          "vllm"
        ]
      },
      "expected_state": "applied",
      "expected_order": [
